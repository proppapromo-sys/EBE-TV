# ── Django ──────────────────────────────────────────────────────────────────
DJANGO_SECRET_KEY=change-me-to-a-long-random-string
DEBUG=true
ALLOWED_HOSTS=*
JWT_SIGNING_KEY=another-long-random-string
# Leave DATABASE_URL/REDIS_URL unset to run on SQLite + in-memory cache (instant local start).
# DATABASE_URL=postgres://user:pass@localhost:5432/streaming
# REDIS_URL=redis://localhost:6379/0
CORS_ALLOWED_ORIGINS=http://localhost:3000
ENTITLEMENT_CACHE_TTL=300

# ── Cloudflare Stream (transcode + CDN + DRM) ─────────────────────────────────
CF_ACCOUNT_ID=
CF_API_TOKEN=
CF_WEBHOOK_SECRET=
CF_STREAM_SIGNING_KEY_ID=
CF_STREAM_SIGNING_KEY_PEM=
CF_CUSTOMER_SUBDOMAIN=customer-XXXX.cloudflarestream.com
PLAYBACK_TOKEN_TTL=120

# ── Stripe (web billing) ──────────────────────────────────────────────────────
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_MONTHLY=
STRIPE_PRICE_ANNUAL=
CHECKOUT_SUCCESS_URL=http://localhost:3000/account?ok=1
CHECKOUT_CANCEL_URL=http://localhost:3000/subscribe?canceled=1

# ── Creator payouts (Stripe Connect; reuses STRIPE_SECRET_KEY) ────────────────
PLATFORM_FEE_BPS=3000                                   # platform cut, basis points (3000 = 30%)
STRIPE_CONNECT_RETURN_URL=http://localhost:3000/creator?onboarded=1
STRIPE_CONNECT_REFRESH_URL=http://localhost:3000/creator?refresh=1

# ── Apple In-App Purchase (StoreKit 2) ────────────────────────────────────────
APPLE_ISSUER_ID=
APPLE_KEY_ID=
APPLE_PRIVATE_KEY=
APPLE_BUNDLE_ID=

# ── Google Play Billing ───────────────────────────────────────────────────────
GOOGLE_SERVICE_ACCOUNT_JSON=
GOOGLE_PACKAGE_NAME=
